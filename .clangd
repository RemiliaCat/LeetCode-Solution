# ============================================================
# clangd configuration
# Documentation:
# https://clangd.llvm.org/config
# ============================================================


# ============================================================
# CompileFlags
# 控制 clangd 如何解析你的源代码。
# ============================================================

CompileFlags:

  # ---------------------------------------------------------
  # Add
  #
  # 向原本的编译命令中添加参数。
  #
  # 例如：
  #   -std=c++20
  #   -Wall
  #   -Ixxx
  # ----------------------------------------------------------

  Add:
    - -Iinclude
    - -Wno-return-type
    - -D_CRT_SECURE_NO_WARNINGS

    # 如果你的项目没有 compilation database，
    # 可以在这里添加头文件搜索路径。
    #
    # - -IH:/projects/MyDataStructure/include

    # 开启常见警告
    #
    # - -Wall
    # - -Wextra

  # ----------------------------------------------------------
  # Remove
  #
  # 从 compilation database 中删除参数。
  #
  # 支持通配符。
  #
  # 例如：
  #   Remove:
  #     - -W*
  #
  # 可以删除所有 -W 开头的 warning 参数。
  # ----------------------------------------------------------

  Remove: []

  # ----------------------------------------------------------
  # CompilationDatabase
  #
  # 指定 compile_commands.json 所在目录。
  #
  # 默认情况下 clangd 会从当前文件所在目录开始，
  # 向父目录搜索 compilation database。
  #
  # 常见 CMake 项目：
  # ----------------------------------------------------------

  CompilationDatabase: None

  # 也可以：
  #
  # CompilationDatabase: Ancestors
  #
  # 表示使用默认行为，从当前目录向上搜索。
  #
  # 或：
  #
  # CompilationDatabase: None
  #
  # 完全不使用 compilation database。

  # ----------------------------------------------------------
  # Compiler
  #
  # 修改编译命令中的 compiler 名称。
  #
  # 例如：
  #
  # Compiler: clang++
  #
  # 或：
  #
  # Compiler: clang-cl
  #
  # 这个设置不仅影响程序名称，
  # 还会影响 clangd 对编译器类型的判断。
  # ----------------------------------------------------------

  # Compiler: clang++

  # ----------------------------------------------------------
  # BuiltinHeaders
  #
  # clangd 使用哪套 builtin headers。
  #
  # Clangd：
  #   使用 clangd 自己内置的 headers。
  #
  # QueryDriver：
  #   尝试从真实编译器中获取 headers。
  #
  # 默认：
  #   Clangd
  # ----------------------------------------------------------

  # BuiltinHeaders: Clangd

---

# Cpp配置
If:
  PathMatch: .*\.cpp$

CompileFlags:
  Add:
    - -std=c++20

---

If:
  PathMatch: .*\.c$

CompileFlags:
  Add:
    - -std=c17
    - -D_CRT_SECURE_NO_WARNINGS

---

# ============================================================
# Index
# 控制 clangd 的索引。
#
# 索引负责：
#   - 查找定义
#   - 查找引用
#   - Workspace Symbols
#   - 跨文件代码理解
# ============================================================

Index:

  # ----------------------------------------------------------
  # Background
  #
  # 是否进行后台索引。
  #
  # Build：
  #   开启后台索引（默认）
  #
  # Skip：
  #   禁用后台索引
  # ----------------------------------------------------------

  Background: Build

  # ----------------------------------------------------------
  # StandardLibrary
  #
  # 是否索引标准库。
  #
  # 默认开启。
  # ----------------------------------------------------------

  StandardLibrary: true

  # ----------------------------------------------------------
  # External
  #
  # 使用外部 index。
  #
  # 一般普通项目不需要配置。
  #
  # 两种形式：
  #
  # File:
  #   使用 clangd-indexer 生成的本地 index
  #
  # Server:
  #   使用远程 index server
  # ----------------------------------------------------------

  # External:
  #
  #   File: /path/to/index.idx
  #
  #   或：
  #
  #   Server: example.com:5900
  #   MountPoint: /path/to/project/


# ============================================================
# Style
# 控制 clangd 对代码风格的一些理解。
#
# 注意：
# 这里不是 clang-format！
# 格式化规则仍然应该放在 .clang-format。
# ============================================================

Style:

  # ----------------------------------------------------------
  # FullyQualifiedNamespaces
  #
  # 指定哪些 namespace 应该始终使用全限定名称。
  #
  # 例如：
  #
  # FullyQualifiedNamespaces:
  #   - std
  #
  # 会倾向于使用：
  #
  #   std::vector
  #
  # 而不是：
  #
  #   vector
  # ----------------------------------------------------------

  FullyQualifiedNamespaces: []

  # ----------------------------------------------------------
  # QuotedHeaders
  #
  # 指定某些 header 应该使用：
  #
  #   #include "foo.h"
  #
  # 而不是：
  #
  #   #include <foo.h>
  #
  # 这里使用正则表达式。
  # ----------------------------------------------------------

  QuotedHeaders: []

  # ----------------------------------------------------------
  # AngledHeaders
  #
  # 与 QuotedHeaders 相反。
  #
  # 指定 header 使用：
  #
  #   #include <foo.h>
  # ----------------------------------------------------------

  AngledHeaders: []


# ============================================================
# Diagnostics
# 控制诊断、clang-tidy、include 检查。
# ============================================================

Diagnostics:

  # ----------------------------------------------------------
  # Suppress
  #
  # 忽略指定诊断。
  #
  # 可以写：
  #
  #   unused-variable
  #   -Wunused-variable
  #   clang-diagnostic-unused-variable
  #
  # 也可以写 clang-tidy check：
  #
  #   readability-identifier-naming
  #
  # "*" 表示关闭所有诊断。
  #
  # 一般不要使用 "*"。
  # ----------------------------------------------------------

  Suppress:
    - unused-value
  # ----------------------------------------------------------
  # ClangTidy
  #
  # clangd 可以运行 clang-tidy。
  # ----------------------------------------------------------

  ClangTidy:

    # --------------------------------------------------------
    # Add
    #
    # 添加 clang-tidy 检查。
    #
    # 例如：
    #
    # Add:
    #   - modernize-*
    #   - performance-*
    #   - readability-*
    # --------------------------------------------------------

    Add: []

    # --------------------------------------------------------
    # Remove
    #
    # 禁用 clang-tidy 检查。
    #
    # 支持通配符。
    #
    # 例如：
    #
    # Remove:
    #   - modernize-use-trailing-return-type
    # --------------------------------------------------------

    Remove: []

    # --------------------------------------------------------
    # CheckOptions
    #
    # 为 clang-tidy 的具体检查提供参数。
    #
    # 例如：
    #
    # readability-identifier-naming.VariableCase: CamelCase
    # --------------------------------------------------------

    CheckOptions: {}

    # --------------------------------------------------------
    # FastCheckFilter
    #
    # 控制 clangd 是否运行较慢的 clang-tidy 检查。
    #
    # Strict：
    #   只运行已知较快的检查。
    #
    # Loose：
    #   除了明确知道很慢的检查之外都运行。
    #
    # None：
    #   全部运行。
    #
    # 默认：
    #   Strict
    # --------------------------------------------------------

    FastCheckFilter: Strict


  # ----------------------------------------------------------
  # UnusedIncludes
  #
  # 检查没有使用的 #include。
  #
  # None：
  #   关闭
  #
  # Strict：
  #   开启
  #
  # clangd 17+ 默认是 Strict。
  # ----------------------------------------------------------

  UnusedIncludes: None


  # ----------------------------------------------------------
  # MissingIncludes
  #
  # 检查代码使用了某个符号，
  # 但没有直接 include 对应 header。
  #
  # None：
  #   关闭（默认）
  #
  # Strict：
  #   开启
  # ----------------------------------------------------------

  MissingIncludes: None


  # ----------------------------------------------------------
  # Includes
  #
  # Include Cleaner 的进一步配置。
  # ----------------------------------------------------------

  Includes:

    # --------------------------------------------------------
    # IgnoreHeader
    #
    # 匹配这些 header 时，不报告 Include Cleaner
    # 的相关诊断。
    #
    # 使用正则表达式。
    #
    # 例如：
    #
    # IgnoreHeader:
    #   - third_party/.*
    # --------------------------------------------------------

    IgnoreHeader: []

    # --------------------------------------------------------
    # AnalyzeAngledIncludes
    #
    # 是否分析：
    #
    #   #include <xxx>
    #
    # 的非标准库 header。
    #
    # 默认 false。
    #
    # 因为很多项目存在 umbrella headers，
    # 开启后可能产生误报。
    # --------------------------------------------------------

    AnalyzeAngledIncludes: false


# ============================================================
# Completion
# 控制代码补全。
# ============================================================

Completion:

  # ----------------------------------------------------------
  # AllScopes
  #
  # 是否在代码补全时搜索所有作用域。
  #
  # true：
  #   可以补全当前 namespace 外的符号。
  #
  # 默认 true。
  # ----------------------------------------------------------

  AllScopes: true


  # ----------------------------------------------------------
  # ArgumentLists
  #
  # 函数补全时如何显示参数列表。
  #
  # FullPlaceholders：
  #   显示完整参数占位符。
  #
  # 常见效果类似：
  #
  #   foo(arg1, arg2)
  # ----------------------------------------------------------

  ArgumentLists: None


  # ----------------------------------------------------------
  # HeaderInsertion
  #
  # 补全一个需要 header 的符号时，
  # 是否自动添加 #include。
  #
  # IWYU：
  #   Include What You Use。
  #
  # None：
  #   不自动添加。
  # ----------------------------------------------------------

  HeaderInsertion: IWYU


  # ----------------------------------------------------------
  # CodePatterns
  #
  # 是否提供代码 pattern/snippet。
  #
  # All：
  #   开启。
  #
  # None：
  #   关闭。
  # ----------------------------------------------------------

  CodePatterns: All


  # ----------------------------------------------------------
  # MacroFilter
  #
  # 控制宏的补全过滤方式。
  #
  # ExactPrefix：
  #   只显示与输入前缀匹配的宏。
  # ----------------------------------------------------------

  MacroFilter: ExactPrefix


# ============================================================
# InlayHints
# 控制 VS Code 中代码里的灰色参数/类型提示。
# ============================================================

InlayHints:

  # ----------------------------------------------------------
  # Enabled
  #
  # 总开关。
  #
  # false 时下面所有 InlayHints 都不会显示。
  # ----------------------------------------------------------

  Enabled: true


  # ----------------------------------------------------------
  # ParameterNames
  #
  # 函数调用时显示参数名称。
  #
  # 例如：
  #
  #   foo(10, 20)
  #
  # 可能显示：
  #
  #   foo(x: 10, y: 20)
  # ----------------------------------------------------------

  ParameterNames: true


  # ----------------------------------------------------------
  # DeducedTypes
  #
  # 显示 auto / 模板推导出的类型。
  #
  # 例如：
  #
  #   auto x = getValue();
  #
  # 显示：
  #
  #   auto x : int
  # ----------------------------------------------------------

  DeducedTypes: true


  # ----------------------------------------------------------
  # Designators
  #
  # 显示 aggregate initialization 的 designator。
  # ----------------------------------------------------------

  Designators: true


  # ----------------------------------------------------------
  # BlockEnd
  #
  # 在代码块结束的位置显示注释提示。
  #
  # 例如：
  #
  #   } // function
  #
  # 默认 false。
  # ----------------------------------------------------------

  BlockEnd: false


  # ----------------------------------------------------------
  # DefaultArguments
  #
  # 显示默认参数提示。
  #
  # 默认 false。
  # ----------------------------------------------------------

  DefaultArguments: false


  # ----------------------------------------------------------
  # TypeNameLimit
  #
  # 类型提示的最大字符长度。
  #
  # 例如：
  #
  # TypeNameLimit: 24
  #
  # 超过 24 个字符就不显示。
  #
  # 0：
  #   不限制。
  # ----------------------------------------------------------

  TypeNameLimit: 24


# ============================================================
# Hover
# 控制鼠标悬浮在符号上时显示的信息。
# ============================================================

Hover:

  # ----------------------------------------------------------
  # ShowAKA
  #
  # 是否显示类型展开后的 AKA 信息。
  #
  # 例如：
  #
  #   vector<int>::value_type
  #
  # 可能显示：
  #
  #   vector<int>::value_type (aka int)
  # ----------------------------------------------------------

  ShowAKA: true


  # ----------------------------------------------------------
  # MacroContentsLimit
  #
  # Hover 显示宏展开内容时的最大字符数。
  #
  # 0：
  #   不限制。
  #
  # 当前默认值：
  #   2048
  # ----------------------------------------------------------

  MacroContentsLimit: 2048


# ============================================================
# SemanticTokens
# 控制语义高亮。
# ============================================================

SemanticTokens:

  # ----------------------------------------------------------
  # DisabledKinds
  #
  # 禁止某些类型的 semantic token。
  #
  # 例如：
  #
  # DisabledKinds:
  #   - variable
  #
  # 注意：
  # 这里的具体 token kind 应以当前 clangd
  # 支持的 LSP semantic token 类型为准。
  # ----------------------------------------------------------

  DisabledKinds: []

  # ----------------------------------------------------------
  # DisabledModifiers
  #
  # 禁止某些 semantic token modifier。
  # ----------------------------------------------------------

  DisabledModifiers: []


# ============================================================
# Documentation
# 控制 Hover 中文档注释的处理方式。
# ============================================================

Documentation:

  # ----------------------------------------------------------
  # CommentFormat
  #
  # 控制文档注释的格式处理。
  #
  # Plaintext：
  #   普通文本。
  # ----------------------------------------------------------

  CommentFormat: Plaintext
